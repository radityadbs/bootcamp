@model Ecommerce.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="d-flex justify-content-center align-items-center min-vh-100 bg-light" id="loginWrapper">
    <div class="card shadow-sm border-0 p-4 p-md-5 text-center" style="width: 380px; border-radius: 16px;">
        <div class="mb-4">
            <div class="d-flex justify-content-center align-items-center mb-3">
                <i class="bi bi-bag-check-fill text-primary" style="font-size: 2rem;"></i>
            </div>
            <h3 class="fw-bold text-primary mb-1">Welcome Back 👋</h3>
            <p class="text-muted mb-0">Sign in to continue to your dashboard</p>
        </div>

        <form asp-action="Login" method="post" class="text-start mt-4">
            <div class="mb-3">
                <label asp-for="UserName" class="form-label fw-semibold">Username</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-person text-muted"></i></span>
                    <input asp-for="UserName" class="form-control border-0 shadow-sm-sm rounded-end"
                        placeholder="Enter your username" />
                </div>
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-lock text-muted"></i></span>
                    <input asp-for="Password" type="password" class="form-control border-0 shadow-sm-sm rounded-end"
                        placeholder="Enter your password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-gradient btn-lg shadow-sm">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Login
                </button>
            </div>
        </form>

        <div class="text-center mt-4">
            <small class="text-muted">
                Don’t have an account?
                <a href="#" class="text-decoration-none fw-semibold text-primary">Contact Admin</a>
            </small>
        </div>

        @* <div class="text-center mt-3">
            <button id="darkModeToggle" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-moon"></i>
            </button>
        </div> *@
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // 🌙 Dark Mode
        const toggle = document.getElementById('darkModeToggle');
        const wrapper = document.getElementById('loginWrapper');
        let dark = localStorage.getItem('darkMode') === 'true';

        function applyDarkMode(on) {
            document.body.classList.toggle('dark-mode', on);
            wrapper.classList.toggle('bg-dark', on);
            toggle.innerHTML = on ? '<i class="bi bi-sun"></i>' : '<i class="bi bi-moon"></i>';
            localStorage.setItem('darkMode', on);
        }

        applyDarkMode(dark);
        toggle.addEventListener('click', () => {
            dark = !dark;
            applyDarkMode(dark);
        });
    </script>

    <style>
        /* 🌈 Gradient Button */
        .btn-gradient {
            background: linear-gradient(90deg, #007bff, #00c6ff);
            border: none;
            color: #fff;
            transition: 0.2s ease;
        }

        .btn-gradient:hover {
            background: linear-gradient(90deg, #0069d9, #00aaff);
            color: #fff;
            transform: translateY(-1px);
        }

        /* 🌙 Dark Mode */
        body.dark-mode {
            background-color: #121212;
            color: #ddd;
        }

        body.dark-mode .card {
            background-color: #1b1b1b;
            color: #ddd;
        }

        body.dark-mode .form-control {
            background-color: #222 !important;
            color: #eee;
            border-color: #333 !important;
        }

        body.dark-mode .form-control::placeholder {
            color: #888;
        }

        body.dark-mode .input-group-text {
            background-color: #222;
            border-color: #333;
            color: #aaa;
        }

        body.dark-mode .btn-outline-secondary {
            border-color: #444;
            color: #ccc;
        }

        body.dark-mode .btn-outline-secondary:hover {
            background-color: #007bff;
            color: #fff;
        }

        /* ✨ Subtle polish */
        .card {
            border-radius: 16px;
            transition: all 0.3s ease;
        }

        .card:hover {
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        }

        .input-group .form-control:focus {
            box-shadow: none;
            outline: none;
            border-color: #007bff;
        }
    </style>
}