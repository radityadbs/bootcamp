@model Ecommerce.Services.ProductResponse
@{
  ViewData["BodyClass"] = "dashboard-page";
}

<div class="container py-4">
  <div class="card shadow-lg border-0" style="border-radius: 12px;">
    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
      <h4 class="mb-0 fw-semibold"><i class="bi bi-info-circle me-2"></i> Product Details</h4>
      <a href="@Url.Action("Index")" class="btn btn-light btn-sm">
        <i class="bi bi-arrow-left"></i> Back
      </a>
    </div>

    <div class="card-body p-4">
      <dl class="row mb-0">
        <dt class="col-sm-3 text-secondary fw-semibold">Product Name</dt>
        <dd class="col-sm-9">@Model.ProductName</dd>

        <dt class="col-sm-3 text-secondary fw-semibold">Price</dt>
        <dd class="col-sm-9 text-success fw-bold">Rp @Model.Price.ToString("N0")</dd>

        <dt class="col-sm-3 text-secondary fw-semibold">Type</dt>
        <dd class="col-sm-9">
          <span class="badge bg-light text-dark border">@Model.ProductTypeName</span>
        </dd>

        <dt class="col-sm-3 text-secondary fw-semibold">ID</dt>
        <dd class="col-sm-9 text-muted small">@Model.ProductId</dd>
      </dl>
    </div>
  </div>
</div>