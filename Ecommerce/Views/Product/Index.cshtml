@model Ecommerce.ViewModels.PagedProductVm
@{
  ViewData["Title"] = "Products";
}

<div class="container py-4">
  <!-- Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 border-bottom pb-3">
    <div class="mb-2">
      <h2 class="fw-bold text-primary mb-0">
        <i class="bi bi-box-seam me-2"></i> Product Management
      </h2>
    </div>

    <div class="d-flex gap-2 align-items-center">
      @if (Context.Session.GetString("IsAdmin") == "True")
      {
        <a class="btn btn-gradient px-4 shadow-sm" href="@Url.Action("Create")">
          <i class="bi bi-plus-lg me-2"></i> Add Product
        </a>
      }
    </div>
  </div>

  <!-- Search -->
  <div class="input-group mb-3 shadow-sm rounded-3">
    <span class="input-group-text bg-light border-0">
      <i class="bi bi-search text-muted"></i>
    </span>
    <input id="searchInput" type="text" class="form-control border-0" placeholder="Search products..." />
  </div>

  <!-- Product Table -->
  @if (!(Model.Products?.Any() ?? false))
  {
    <div class="alert alert-info text-center py-5 shadow-sm rounded-3">
      <i class="bi bi-box-seam display-6 text-secondary mb-3 d-block"></i>
      <h5 class="fw-semibold mb-1">No products found</h5>
      <p class="text-muted mb-0">Start by adding your first product!</p>
    </div>
  }
  else
  {
    <div class="card border-0 shadow-sm rounded-4">
      <div class="table-responsive">
        <table id="productTable" class="table table-hover align-middle mb-0">
          <thead class="table-light border-bottom small">
            <tr>
              <th class="sortable" data-sort="name">
                Name <i class="bi bi-chevron-expand text-muted"></i>
              </th>
              <th class="text-end sortable" data-sort="price">
                <span class="text-muted">Rp</span> Harga
                <i class="bi bi-chevron-expand text-muted ms-1"></i>
              </th>
              <th class="text-center sortable" data-sort="type">
                Type <i class="bi bi-chevron-expand text-muted"></i>
              </th>
              <th class="text-end" style="width:220px;">Actions</th>
            </tr>
          </thead>
          <tbody id="productBody">
            @foreach (var p in Model.Products)
            {
              <tr class="product-row">
                <td class="fw-semibold text-dark">@p.ProductName</td>
                <td class="text-end text-success fw-bold">Rp @p.Price.ToString("N0")</td>
                <td class="text-center">
                  <span class="badge rounded-pill bg-light text-dark border">@p.ProductTypeName</span>
                </td>
                <td class="text-end">
                  <div class="btn-group">
                    <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Details", new { id = p.ProductId })"
                      title="View">
                      <i class="bi bi-eye"></i>
                    </a>

                    @if (Context.Session.GetString("IsAdmin") == "True")
                    {
                      <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", new { id = p.ProductId })"
                        title="Edit">
                        <i class="bi bi-pencil-square"></i>
                      </a>
                      <button type="button" class="btn btn-sm btn-outline-danger js-delete" data-id="@p.ProductId"
                        data-name="@p.ProductName" title="Delete">
                        <i class="bi bi-trash3"></i>
                      </button>
                    }
                  </div>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination -->
    <nav class="mt-4">
      <ul class="pagination justify-content-center mb-0">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
          <a class="page-link shadow-sm" href="@Url.Action("Index", new { page = Model.CurrentPage - 1 })">
            <i class="bi bi-chevron-left"></i>
          </a>
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
          <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
            <a class="page-link shadow-sm" href="@Url.Action("Index", new { page = i })">@i</a>
          </li>
        }

        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
          <a class="page-link shadow-sm" href="@Url.Action("Index", new { page = Model.CurrentPage + 1 })">
            <i class="bi bi-chevron-right"></i>
          </a>
        </li>
      </ul>
    </nav>
  }
</div>

@section Scripts {
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const searchInput = document.getElementById('searchInput');
      const rows = document.querySelectorAll('#productBody tr');
      const headers = document.querySelectorAll('.sortable');
      let sortOrder = 1;

      // ✅ Realtime Search
      searchInput.addEventListener('keyup', () => {
        const term = searchInput.value.toLowerCase();
        rows.forEach(row => {
          const text = row.textContent.toLowerCase();
          row.style.display = text.includes(term) ? '' : 'none';
        });
      });

      // ✅ Sorting
      headers.forEach(header => {
        header.addEventListener('click', () => {
          const type = header.dataset.sort;
          const table = document.getElementById('productTable');
          const body = table.querySelector('tbody');
          const rowsArr = Array.from(body.querySelectorAll('tr'));

          rowsArr.sort((a, b) => {
            let valA, valB;

            if (type === 'price') {
              // Ambil nilai angka dari text (hilangkan Rp dan titik)
              valA = parseFloat(a.cells[1].innerText.replace(/[^\d]/g, '')) || 0;
              valB = parseFloat(b.cells[1].innerText.replace(/[^\d]/g, '')) || 0;
            } else if (type === 'name') {
              valA = a.cells[0].innerText.toLowerCase();
              valB = b.cells[0].innerText.toLowerCase();
            } else {
              valA = a.cells[2].innerText.toLowerCase();
              valB = b.cells[2].innerText.toLowerCase();
            }

            return (valA > valB ? 1 : -1) * sortOrder;
          });

          sortOrder *= -1;
          body.innerHTML = '';
          rowsArr.forEach(row => body.appendChild(row));
        });
      });
      // ✅ DELETE AJAX pakai SweetAlert2
      const deleteButtons = document.querySelectorAll('.js-delete');

      deleteButtons.forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.id;
          const name = btn.dataset.name;

          // 🔹 Tampilkan popup konfirmasi modern
          const confirmResult = await Swal.fire({
            title: 'Delete this product ?',
            html: `<strong>${name}</strong> will be deleted.`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, delete !',
            cancelButtonText: 'Cancel',
            reverseButtons: true,
            customClass: {
              confirmButton: 'btn btn-danger px-4',
              cancelButton: 'btn btn-secondary px-4'
            },
            buttonsStyling: false
          });

          if (!confirmResult.isConfirmed) return;

          try {
            const response = await fetch(`/Product/DeleteAjax/${id}`, {
              method: 'POST',
              headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '',
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({ id })
            });

            const result = await response.json();

            if (result.ok) {
              // 🎉 Popup sukses
              await Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: result.message,
                showConfirmButton: false,
                timer: 1500,
                customClass: { popup: 'rounded-4 shadow-lg' }
              });

              // Hapus baris dari tabel
              btn.closest('tr').style.transition = 'opacity 0.3s ease';
              btn.closest('tr').style.opacity = '0';
              setTimeout(() => btn.closest('tr').remove(), 300);
            } else {
              // ❌ Popup gagal
              Swal.fire({
                icon: 'error',
                title: 'Failed!',
                text: result.message || 'Failed to delete this product.',
                confirmButtonText: 'OK',
                customClass: { confirmButton: 'btn btn-danger px-4' },
                buttonsStyling: false
              });
            }
          } catch (error) {
            Swal.fire({
              icon: 'error',
              title: 'Oops...',
              text: 'There is something wrong!!.',
              confirmButtonText: 'OK',
              customClass: { confirmButton: 'btn btn-danger px-4' },
              buttonsStyling: false
            });
            console.error(error);
          }
        });
      });

    });
  </script>

  <style>
    /* 🌈 Gradient Button */
    .btn-gradient {
      background: linear-gradient(90deg, #007bff, #00c6ff);
      color: #fff;
      border: none;
    }

    .btn-gradient:hover {
      background: linear-gradient(90deg, #0069d9, #00aaff);
    }

    /* ✨ Hover & Table Enhancements */
    .product-row:hover {
      background-color: #f8f9fa;
      transition: 0.2s ease;
    }

    .table thead th {
      cursor: pointer;
    }

    .table-hover tbody tr {
      transition: 0.15s ease;
    }

    .table-hover tbody tr:hover {
      background-color: #f1f5ff;
      transform: scale(1.005);
    }

    /* 🔘 Pagination */
    .page-link {
      border-radius: 8px !important;
    }

    .swal2-popup {
      border-radius: 16px !important;
      font-family: 'Inter', sans-serif;
      padding: 1.5rem 1.2rem !important;
    }

    .swal2-title {
      font-weight: 600 !important;
    }

    .swal2-styled.swal2-confirm {
      background: linear-gradient(90deg, #007bff, #00c6ff) !important;
      border: none !important;
    }
  </style>
}